# Copy to `.env.local` (gitignored) for secrets that must not live in `.env`.
# `pnpm dev` merges `.env` + `.env.local` (local wins).

# Google OAuth — Web application client from Google Cloud Console
# Redirect URIs (API port 3001, not web 8080):
#   http://127.0.0.1:3001/api/v1/auth/google/callback
#   http://localhost:3001/api/v1/auth/google/callback
# JavaScript origins (web port 8080):
#   http://127.0.0.1:8080
#   http://localhost:8080
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
