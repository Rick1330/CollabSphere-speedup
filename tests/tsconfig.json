{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "unit/**/*.ts"
  ]
}
