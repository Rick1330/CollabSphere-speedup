# CollabSphere local environment example
# Use this file as the source for both local env surfaces:
# - copy the whole file to `.env` so Docker Compose gets infrastructure keys and
#   app processes get the shared local runtime defaults
# - copy machine-specific runtime overrides into `.env.local` only when a
#   developer needs values that differ from the shared defaults
# Never commit `.env.local`.
#
# Values below match the current `docker-compose.yml` defaults and the canonical
# local-development env contracts from
# `docs/spec/07-architecture/07.5-config-environments.md` and
# `docs/spec/14-devops/14.3-*`.

# Docker Compose infrastructure defaults
# Update `*_PORT` values in `.env` if the host port is already in use before
# rerunning `docker compose up -d`.
# If you override a published port here, also update any corresponding runtime
# URL below (`DATABASE_URL`, `REDIS_URL`, `COLLAB_*_URL`, `S3_ENDPOINT`).
POSTGRES_DB=collabsphere
POSTGRES_PASSWORD=collab
POSTGRES_PORT=5432
POSTGRES_USER=collab

# Redis host port published by Docker Compose.
REDIS_PORT=6379

# MailHog captures outbound email locally. SMTP uses `MAILHOG_SMTP_PORT`; the
# browser UI uses `MAILHOG_UI_PORT`.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# MinIO stays disabled unless the `minio` profile is enabled explicitly, for
# example with `docker compose --profile minio up -d`.
# COMPOSE_PROFILES=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ROOT_USER=minioadmin

# Application runtime defaults
# These runtime variables are validated at startup. Unless noted as optional,
# they are required by the current shared runtime contract. Local dev validation
# treats every key listed in this file as required in `.env` / `.env.local`,
# even if the runtime contract marks a key optional.
# Host-run services connect through the published Docker ports above.
DATABASE_URL=postgresql://collab:collab@localhost:5432/collabsphere
REDIS_URL=redis://localhost:6379

# Local-only auth placeholders. Replace these outside local development.
# TTLs are positive integers (minutes / days).
# API validates these keys via `parseApiRuntimeEnv` in `packages/shared/src/api-env.ts`.
JWT_ACCESS_SECRET=replace-with-local-jwt-secret
# Keep JWT_ACCESS_SECRET stable across API restarts. Changing it invalidates all
# issued access tokens and in-flight Google OAuth state — sign out, clear localStorage
# key `cs-auth-session`, and sign in again after any JWT_ACCESS_SECRET change.
JWT_ACCESS_TTL_MINUTES=15
BCRYPT_COST=12
REFRESH_TOKEN_TTL_DAYS=7

# Optional — Google OAuth for Nest (`GET /api/v1/auth/google`). Both must be set to enable.
# Redirect URI in Google Cloud Console must match exactly (Nest builds it from `API_BASE_URL`):
#   {API_BASE_URL}/api/v1/auth/google/callback
# Example: `http://127.0.0.1:3001/api/v1/auth/google/callback` when `API_BASE_URL=http://127.0.0.1:3001`.
# After sign-in, the API redirects the browser to `WEB_APP_URL` (see root `.env`) with tokens in `#oauth=...`.
# Google sign-in for an email that already exists as a local (seeded) account returns ACCOUNT_EXISTS_LOCAL —
# use email/password for that account or a different Google account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# MailHog handles local email capture, so this provider key can stay a
# placeholder unless you are intentionally testing a real email provider.
EMAIL_PROVIDER_API_KEY=replace-with-local-email-key
# Local-only SMTP overrides for MailHog-backed dev email routing. These are not
# part of the canonical required env list in
# `docs/spec/07-architecture/07.5-config-environments.md`;
# keep them unset unless you need to override `pnpm dev` defaults (`127.0.0.1`
# + `MAILHOG_SMTP_PORT`).
# EMAIL_SMTP_HOST=127.0.0.1
# EMAIL_SMTP_PORT=1025

# Base URLs for local web and API development.
# Local dev port contract (validated by `pnpm dev` via packages/shared dev-port-contract):
#   | Service              | Port | Env / notes                                      |
#   | Nest API + Socket.IO | 3001 | PORT, API_BASE_URL — OAuth redirect uses API_BASE_URL |
#   | Vite web (SPA)       | 8080 | WEB_APP_URL, BASE_URL — open http://127.0.0.1:8080   |
#   | Hocuspocus collab    | 3002 | COLLAB_WS_URL ws://127.0.0.1:3002 (no /collab path)  |
# Keep PORT in sync with API_BASE_URL. Do not point OAuth at 3002 (collab only).
PORT=3001
# Hocuspocus collab HTTP/WS port (must not reuse PORT=3001 or REST calls hit collab and return 404).
COLLAB_PORT=3002
# HOST=0.0.0.0
# CORS_ORIGINS is a comma-separated list of bare origins (scheme + host + optional port).
API_BASE_URL=http://127.0.0.1:3001
BASE_URL=http://127.0.0.1:8080
# SPA origin for Google OAuth completion redirect (`/login#oauth=...`). Use 127.0.0.1 (not localhost).
WEB_APP_URL=http://127.0.0.1:8080
# Required in local dev — restart `pnpm dev` after edits. Must include your SPA origin (WEB_APP_URL).
# Include both loopback SPA hosts so API calls work from 127.0.0.1:8080 and localhost:8080 (Vite redirects localhost → 127.0.0.1).
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3001
# Vite web — loaded from repo root `.env` (see apps/web/vite.config.ts envDir).
# Default: browser calls API directly on port 3001 (needs CORS_ORIGINS above). Run `pnpm verify:cors` after API start.
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_COLLAB_WS_URL=ws://127.0.0.1:3002
# Recommended on Windows when switching accounts (logout → login): same-origin `/api/v1` on port 8080.
# Vite proxies to VITE_API_PROXY_TARGET; OAuth redirect URIs still use API_BASE_URL on port 3001.
# VITE_USE_DEV_PROXY=true
# VITE_REALTIME_BASE_URL=http://127.0.0.1:3001

# Collaboration service defaults share the same local Postgres and Redis.
# COLLAB_WS_URL must be ws:// or wss://.
COLLAB_DATABASE_URL=postgresql://collab:collab@localhost:5432/collabsphere
# Must be at least 32 characters (validated by API and collab startup).
COLLAB_JWT_SECRET=replace-with-local-collab-secret-at-least-32-chars
# Optional at runtime: set if collab uses a dedicated Redis. Still required in
# local `.env` because it is listed in this file.
COLLAB_REDIS_URL=redis://localhost:6379
COLLAB_WS_URL=ws://127.0.0.1:3002

# Object storage defaults for local file development when MinIO is enabled.
# S3_ENDPOINT is optional at runtime (required only for non-AWS endpoints like
# MinIO). It is still required in local `.env` because it is listed in this file.
# The other S3_* values are required by the current runtime contract.
S3_ACCESS_KEY_ID=minioadmin
S3_BUCKET=collabsphere-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# Local demo accounts (after DB migrate + seed — not automatic on `pnpm dev`)
# -----------------------------------------------------------------------------
# 1. `docker compose up -d` then `pnpm prisma migrate deploy` (from repo root; see `package.json` `prisma` script).
# 2. Demo UI dataset + primary admin login:
#    `pnpm demo:seed-runtime`
#    - elshaday@collabsphere.app / Demo1234!   (global ADMIN)
#    - kidist@collabsphere.app / Demo1234!    (USER)
# 3. Optional narrower Phase 2 fixture users:
#    `pnpm phase2:seed-runtime`
#    - phase2.tester@collabsphere.local / Phase2!Test123
#    - phase2.admin@collabsphere.local / Phase2!Admin123
# Mock-only accounts in the web repo (for reference, not DB-backed):
#    see `apps/web/src/lib/mock-accounts.ts` — same password Demo1234! for listed emails.
