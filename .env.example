# CollabSphere local development — copy to `.env` and adjust secrets.
# `pnpm dev` validates every key here is set in `.env` (and optional `.env.local` overrides).

# --- Docker Compose ports (host) ---
POSTGRES_PORT=5432
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab
POSTGRES_DB=collabsphere
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=collabsphere
MINIO_ROOT_PASSWORD=collabsphere_secret_key_change_in_production

# --- API / app ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://collab:collab@127.0.0.1:5432/collabsphere
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-local-jwt-secret-at-least-32-chars-long
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3001
API_BASE_URL=http://127.0.0.1:3001
BASE_URL=http://127.0.0.1:8080
WEB_APP_URL=http://127.0.0.1:8080

# Email (MailHog via compose)
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_PROVIDER_API_KEY=local-dev-email-key-not-used-with-smtp

# Google OAuth — placeholders only (pnpm dev requires non-empty values).
# Put real credentials in `.env.local` (see `.env.local.example`); never commit secrets.
GOOGLE_CLIENT_ID=local-dev-disabled
GOOGLE_CLIENT_SECRET=local-dev-disabled

# --- Collab (Hocuspocus) ---
COLLAB_PORT=3002
COLLAB_DATABASE_URL=postgresql://collab:collab@127.0.0.1:5432/collabsphere
COLLAB_REDIS_URL=redis://127.0.0.1:6379
COLLAB_JWT_SECRET=replace-with-local-collab-jwt-secret-at-least-32-chars
COLLAB_WS_URL=ws://127.0.0.1:3002/collab
VITE_COLLAB_WS_URL=ws://127.0.0.1:3002/collab
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1

# --- Object storage (MinIO via compose) ---
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (above) must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
# If you change credentials after first boot, reset minio_data or run: docker exec collabsphere-minio printenv MINIO_ROOT_USER
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=documents
S3_ACCESS_KEY_ID=collabsphere
S3_SECRET_ACCESS_KEY=collabsphere_secret_key_change_in_production
S3_REGION=us-east-1
STORAGE_TYPE=s3
# Prefer D: on Windows when C: is low — e.g. D:\collabsphere-data\uploads
STORAGE_LOCAL_PATH=D:\collabsphere-data\uploads

# DOCX import — API and host worker must use the same folder (recommended on Windows)
DOCX_IMPORT_TMP_DIR=D:\collabsphere-data\docx-imports
DOCX_IMPORT_HOST_PATH=D:\collabsphere-data\docx-imports
# 0 = host worker + local LibreOffice (default; pnpm dev starts worker on host)
# 1 = Docker worker with LibreOffice in image (optional; needs Docker bind mount on Windows)
DEV_WORKER_DOCKER=0

# Host worker: install LibreOffice, then set path (pnpm dev verifies before starting worker)
# winget install TheDocumentFoundation.LibreOffice
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Worker S3 (when STORAGE_TYPE=s3) — aliases AWS_* for compatibility
AWS_S3_BUCKET=documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=collabsphere
AWS_SECRET_ACCESS_KEY=collabsphere_secret_key_change_in_production
