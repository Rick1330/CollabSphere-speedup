{
  "name": "@collabsphere/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@collabsphere/shared": "workspace:*",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "dev:nest": "tsx watch src/main.ts",
    "build": "pnpm --filter @collabsphere/database run generate && pnpm exec tsc -p tsconfig.json && tsx ../../scripts/build-bootstrap-app.ts .",
    "test": "pnpm exec tsx --test --test-concurrency=1 ../../tests/unit/api-auth-register.test.ts ../../tests/unit/api-bootstrap-env.test.ts ../../tests/unit/api-email-config.test.ts ../../tests/unit/api-error-filter.test.ts ../../tests/unit/api-pagination.test.ts ../../tests/unit/api-request-id.test.ts ../../tests/unit/api-response-envelope.test.ts ../../tests/unit/api-soft-delete-prisma.test.ts ../../tests/unit/api-workspace-scope-prisma.test.ts test/pagination.e2e-spec.ts"
  }
}
