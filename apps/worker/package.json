{
  "name": "@collabsphere/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@collabsphere/docx-import": "workspace:*",
    "@collabsphere/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.20",
    "@prisma/client": "^6.7.0",
    "bullmq": "^5.58.5",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.1",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:once": "tsx src/main.ts",
    "dev:legacy": "tsx watch src/dev.ts",
    "start": "node dist/main.js",
    "build": "pnpm --filter @collabsphere/database run generate && pnpm exec tsc -p tsconfig.json && tsx ../../scripts/build-bootstrap-app.ts .",
    "test": "pnpm exec vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
