# CollabSphere web — environment variables
#
# Hocuspocus / Yjs WebSocket endpoint (required for live collaboration).
# MUST be an absolute ws:// or wss:// URL pointing at the Hocuspocus server.
#
# Do not use:
# - A relative path like `/w/...` (resolves to the Vite dev server, e.g. :8080).
# - The SPA document URL, e.g. ws://127.0.0.1:8080/w/<workspace>/documents/<doc>
#   (that is the React app, not collab).
#
# Example local dev:
# VITE_COLLAB_WS_URL=ws://127.0.0.1:3002/collab

VITE_COLLAB_WS_URL=ws://127.0.0.1:3002/collab
