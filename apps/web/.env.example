# apps/web — Vite environment (only variables the client reads)
#
# See `apps/web/src/api/client/index.ts` (`resolveConfiguredApiBaseUrl`, `resolveRealtimeSocketOrigin`).
# Google OAuth starts on the API: `{API_BASE_URL}/api/v1/auth/google` — no VITE_GOOGLE_* keys.
#
# VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
# VITE_USE_DEV_PROXY=true
# VITE_REALTIME_BASE_URL=http://127.0.0.1:3001
# VITE_COLLAB_WS_URL=ws://127.0.0.1:3001/collaboration
