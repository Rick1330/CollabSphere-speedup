{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@collabsphere/ui": [
        "packages/ui/src/index.ts"
      ],
      "@collabsphere/ui/*": [
        "packages/ui/src/*"
      ],
      "@collabsphere/shared": [
        "packages/shared/src/index.ts"
      ],
      "@collabsphere/shared/s3-env": [
        "packages/shared/src/s3-env.ts"
      ],
      "@collabsphere/docx-import": [
        "packages/docx-import/src/index.ts"
      ],
      "@collabsphere/docx-import/*": [
        "packages/docx-import/src/*"
      ],
      "@collabsphere/docx-import/server": [
        "packages/docx-import/src/server.ts"
      ]
    }
  }
}
